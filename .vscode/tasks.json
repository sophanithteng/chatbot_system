{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run RAG Backend API",
			"type": "shell",
			"command": ".\\Backend\\.venv\\Scripts\\python.exe",
			"args": [
				"-m",
				"uvicorn",
				"api:app",
				"--app-dir",
